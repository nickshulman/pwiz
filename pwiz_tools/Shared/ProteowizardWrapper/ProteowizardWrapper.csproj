<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vendor-license opt-in, read the SAME two ways pwiz-sharp reads it, because the net8
       target compiles against types pwiz-sharp drops in a no-vendor build.

       There are two ways to agree, and they do NOT have the same reach:
         * -p:IAgreeToVendorLicenses=true (build.bat / build.ps1 / Build-Skyline -VendorLicenses)
           is a GLOBAL property, so it arrives here on its own.
         * pwiz-sharp\i-agree-to-the-vendor-licenses.bat writes pwiz-sharp\Directory.Build.user.props,
           which only pwiz-sharp\Directory.Build.props imports - projects outside
           pwiz-sharp\ never see it.
       Without this import the second route would leave pwiz-sharp compiling the lockmass
       refiners while this project believed they were absent, silently dropping Waters
       lockmass correction from a build that fully supports it. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\pwiz-sharp\Directory.Build.user.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\pwiz-sharp\Directory.Build.user.props')" />

  <!-- ProteowizardWrapper — the Phase-2 chokepoint. Multi-target net472 (legacy
       pwiz.CLI bindings) + PLAIN net10.0 (pwiz-sharp managed port).

       The net8 target is deliberately net10.0 and NOT net10.0-windows: it was only
       -windows because pwiz.CommonUtil set UseWindowsForms, and CommonUtil has now
       been split (its WinForms types live in CommonBaseUI). A plain net10.0 wrapper is
       what lets Osprey consume it on Linux instead of reading pwiz-sharp directly.

       Same MsDataFileImpl class name and public surface in both targets. The
       net472 legacy MsDataFileImpl.cs is excluded on net10.0 - instead
       we pull the parallel implementation from the
       ../ProteowizardWrapper.PwizSharp/ sandbox directory, which has the same
       public API but uses pwiz-sharp internally. Eventually the sandbox file
       gets merged in-place but for now this lets Skyline link against pwiz-sharp
       on net8 with zero call-site changes. -->
  <PropertyGroup>
    <ProjectGuid>{DACEE7D5-5A6A-4001-9602-FAB1A9A2DE59}</ProjectGuid>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>pwiz.ProteowizardWrapper</RootNamespace>
    <AssemblyName>ProteowizardWrapper</AssemblyName>
    <Company>University of Washington</Company>
    <Product>ProteowizardWrapper</Product>
    <AssemblyTitle>ProteowizardWrapper</AssemblyTitle>
    <Copyright>Copyright © University of Washington 2026</Copyright>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>


  <!-- Mirrors Analysis.csproj: when the licenses are not agreed, pwiz-sharp Compile-Removes
       SpectrumList_LockmassRefiner / ChromatogramListLockmassRefiner and defines
       NO_VENDOR_SUPPORT. This project consumes those types, so it has to be told the same
       thing or it fails to compile in exactly the configuration CI and the shipped zips
       build. net8 only - the net472 target reaches pwiz through pwiz.CLI, where the
       refiners are always present. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0' AND '$(IAgreeToVendorLicenses)' != 'true'">
    <DefineConstants>$(DefineConstants);NO_VENDOR_SUPPORT</DefineConstants>
  </PropertyGroup>

  <!-- On net8 the data layer comes from pwiz-sharp. No pwiz.CLI, no C++/CLI bindings.

       pwiz-sharp is not part of Skyline.sln and Visual Studio never builds it: the
       command-line build (pwiz_tools\Skyline\build.bat) builds it first, and the IDE
       consumes the already-built assemblies. So these are plain file References, not
       ProjectReferences. A ProjectReference to a project outside the solution being
       built has no solution-configuration entry, so MSBuild strips Configuration and
       Platform before invoking it and the referenced project answers with its own
       default, Debug: a Release build of Skyline.sln silently linked pwiz-sharp's Debug
       binaries (observed 2026-09-02). With $(Configuration) in the path, the Debug or
       Release choice made in the IDE selects the matching pwiz-sharp build.

       pwiz-sharp always builds AnyCPU into bin\<Config>\net10.0, whatever platform
       Skyline.sln is built with, so the paths carry $(Configuration) but not $(Platform).
       Only the assemblies this project compiles against are listed; their own
       dependencies (Pwiz.Vendor.Common, Pwiz.Data.IdentData, the vendor SDK
       assemblies, ...) sit next to them and ResolveAssemblyReferences picks them up. -->
  <PropertyGroup>
    <PwizSharpSrc>$(MSBuildThisFileDirectory)..\..\..\pwiz-sharp\pwiz\src\</PwizSharpSrc>
    <PwizSharpBin>bin\$(Configuration)\net10.0\</PwizSharpBin>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Reference Include="Pwiz.Data.MsData">
      <HintPath>$(PwizSharpSrc)MsData\$(PwizSharpBin)Pwiz.Data.MsData.dll</HintPath>
    </Reference>
    <Reference Include="Pwiz.Analysis">
      <HintPath>$(PwizSharpSrc)Analysis\$(PwizSharpBin)Pwiz.Analysis.dll</HintPath>
    </Reference>
    <Reference Include="Pwiz.Data.Common">
      <HintPath>$(PwizSharpSrc)Common\$(PwizSharpBin)Pwiz.Data.Common.dll</HintPath>
    </Reference>
    <Reference Include="Pwiz.Util">
      <HintPath>$(PwizSharpSrc)Util\$(PwizSharpBin)Pwiz.Util.dll</HintPath>
    </Reference>
    <!-- Vendor readers: pwiz-sharp's ReaderList.Default only has mzML/mzMLb/mzXML/MGF/MSn/BTDX.
         Reference the vendor assemblies so their Reader_X classes can be added to
         ReaderList.AdditionalReaders at MsDataFileImpl static-ctor time (see
         MsDataFileImpl.cs). Without these, Thermo/Waters/Sciex/etc. files fail
         with "No registered reader recognized the file". -->
    <Reference Include="Pwiz.Vendor.Thermo">
      <HintPath>$(PwizSharpSrc)Vendor\Thermo\$(PwizSharpBin)Pwiz.Vendor.Thermo.dll</HintPath>
    </Reference>
    <Reference Include="Pwiz.Vendor.Waters">
      <HintPath>$(PwizSharpSrc)Vendor\Waters\$(PwizSharpBin)Pwiz.Vendor.Waters.dll</HintPath>
    </Reference>
    <Reference Include="Pwiz.Vendor.Sciex">
      <HintPath>$(PwizSharpSrc)Vendor\Sciex\$(PwizSharpBin)Pwiz.Vendor.Sciex.dll</HintPath>
    </Reference>
    <Reference Include="Pwiz.Vendor.Shimadzu">
      <HintPath>$(PwizSharpSrc)Vendor\Shimadzu\$(PwizSharpBin)Pwiz.Vendor.Shimadzu.dll</HintPath>
    </Reference>
    <Reference Include="Pwiz.Vendor.Agilent">
      <HintPath>$(PwizSharpSrc)Vendor\Agilent\$(PwizSharpBin)Pwiz.Vendor.Agilent.dll</HintPath>
    </Reference>
    <Reference Include="Pwiz.Vendor.Bruker">
      <HintPath>$(PwizSharpSrc)Vendor\Bruker\$(PwizSharpBin)Pwiz.Vendor.Bruker.dll</HintPath>
    </Reference>
    <Reference Include="Pwiz.Vendor.UIMF">
      <HintPath>$(PwizSharpSrc)Vendor\UIMF\$(PwizSharpBin)Pwiz.Vendor.UIMF.dll</HintPath>
    </Reference>
    <Reference Include="Pwiz.Vendor.UNIFI">
      <HintPath>$(PwizSharpSrc)Vendor\UNIFI\$(PwizSharpBin)Pwiz.Vendor.UNIFI.dll</HintPath>
    </Reference>
    <Reference Include="Pwiz.Vendor.Mobilion">
      <HintPath>$(PwizSharpSrc)Vendor\Mobilion\$(PwizSharpBin)Pwiz.Vendor.Mobilion.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Fail early, and say why, when pwiz-sharp has not been built for this Configuration.
       Without this the build reports MSB3245 plus hundreds of CS0246s. -->
  <Target Name="CheckPwizSharpBuilt" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(TargetFramework)' == 'net10.0'">
    <Error Condition="'%(Reference.HintPath)' != '' And !Exists('%(Reference.HintPath)')"
           Text="pwiz-sharp assembly not found: %(Reference.HintPath). pwiz-sharp is not part of Skyline.sln; build it for the $(Configuration) configuration from the command line first (pwiz_tools\Skyline\build.bat $(Configuration) --no-tests)." />
  </Target>

  <!-- Two things a ProjectReference carried along implicitly that a file reference does not.

       1. The NuGet packages the pwiz-sharp assemblies need at run time. They are not in the
          pwiz-sharp bin folders (SDK libraries do not copy package assemblies), and they only
          reached Skyline.deps.json through the transitive project graph. Declare them here so
          the runtime still finds HDF5 (mzMLb), SQLite (Bruker, UIMF) and the framework
          compatibility packages the Sciex, Agilent and Shimadzu SDKs use. Versions match the
          pwiz-sharp csprojs; keep them in sync. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="HDF.PInvoke.1.10" Version="1.10.612" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="System.Runtime.Caching" Version="8.0.0" />
    <PackageReference Include="System.Runtime.Serialization.Formatters" Version="9.0.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.2" />
  </ItemGroup>

  <!-- 2. The vendor projects' Content: native SDK libraries (timsdata.dll, MassLynxRaw.dll,
          MobilionShim.dll, ...), license.key files, .config files, the VC90 side-by-side
          folders Bruker needs, and assemblies loaded by reflection. A ProjectReference
          propagated them through GetCopyToOutputDirectoryItems; deploy the pwiz-sharp output
          folders wholesale instead. The managed assemblies come along twice (here and
          copy-local from the References above) - same source file, same destination,
          harmless. Content items propagate through ProjectReference, so Skyline and the
          test projects that reference it get all of this too. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Content Include="$(PwizSharpSrc)MsData\$(PwizSharpBin)**\*;
                      $(PwizSharpSrc)Analysis\$(PwizSharpBin)**\*;
                      $(PwizSharpSrc)Common\$(PwizSharpBin)**\*;
                      $(PwizSharpSrc)Util\$(PwizSharpBin)**\*;
                      $(PwizSharpSrc)Vendor\Thermo\$(PwizSharpBin)**\*;
                      $(PwizSharpSrc)Vendor\Waters\$(PwizSharpBin)**\*;
                      $(PwizSharpSrc)Vendor\Sciex\$(PwizSharpBin)**\*;
                      $(PwizSharpSrc)Vendor\Shimadzu\$(PwizSharpBin)**\*;
                      $(PwizSharpSrc)Vendor\Agilent\$(PwizSharpBin)**\*;
                      $(PwizSharpSrc)Vendor\Bruker\$(PwizSharpBin)**\*;
                      $(PwizSharpSrc)Vendor\UIMF\$(PwizSharpBin)**\*;
                      $(PwizSharpSrc)Vendor\UNIFI\$(PwizSharpBin)**\*;
                      $(PwizSharpSrc)Vendor\Mobilion\$(PwizSharpBin)**\*"
             Exclude="$(PwizSharpSrc)*\$(PwizSharpBin)*.deps.json;$(PwizSharpSrc)Vendor\*\$(PwizSharpBin)*.deps.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommonUtil\CommonUtil.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- On net8 swap legacy MsDataFileImpl + siblings for the pwiz-sharp-backed
         sandbox implementation (same public surface, different internals). -->
    <Compile Remove="MsDataFileImpl.cs" Condition="'$(TargetFramework)' == 'net10.0'" />
    <Compile Remove="MsDataFileInfo.cs" Condition="'$(TargetFramework)' == 'net10.0'" />
    <Compile Remove="IterationListenerToMonitor.cs" Condition="'$(TargetFramework)' == 'net10.0'" />
    <!-- DiaUmpire.cs now compiles on net8 too: the pwiz.CLI dependency was only two
         enum-discriminator values, replaced with plain literals. The wrapper's job
         (write msconvert-compatible .params + parse DIA-Umpire userParams back out of mzML)
         doesn't touch the engine - msconvert runs DIA-Umpire out of process. -->
    <Compile Include="..\ProteowizardWrapper.PwizSharp\MsDataFileImpl.cs" Condition="'$(TargetFramework)' == 'net10.0'" Link="MsDataFileImpl.cs" />
    <Compile Include="..\ProteowizardWrapper.PwizSharp\MsDataFileImpl.Vendors.cs" Condition="'$(TargetFramework)' == 'net10.0'" Link="MsDataFileImpl.Vendors.cs" />
    <Compile Include="..\ProteowizardWrapper.PwizSharp\MsDataFileInfo.cs" Condition="'$(TargetFramework)' == 'net10.0'" Link="MsDataFileInfo.cs" />
  </ItemGroup>

</Project>
